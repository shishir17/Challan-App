{
  "name": "challan-sender",
  "version": "2.0.0",
  "description": "UP Traffic Department - Bulk Challan Messenger (SMS + WhatsApp Auto Send)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --publish never",
    "build-linux": "electron-builder --linux --publish never",
    "build-mac": "electron-builder --mac --publish never"
  },
  "build": {
    "appId": "com.up.traffic.challan-sender",
    "productName": "Challan Sender",
    "directories": { "output": "dist" },
    "win": { "target": "nsis" },
    "linux": { "target": "AppImage" },
    "mac": { "target": "dmg" }
  },
  "dependencies": {
    "xlsx": "^0.18.5",
    "axios": "^1.6.7"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  }
}
